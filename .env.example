NODE_ENV=development
DB_CLIENT=sqlite
# DATABASE_URL is required when DB_CLIENT is mysql or postgres.
# Example MySQL: mysql://user:password@127.0.0.1:3306/kyanet_workstation
# Example Postgres: postgres://user:password@127.0.0.1:5432/kyanet_workstation
DATABASE_URL=
PORT=3000
LISTEN_HOST=127.0.0.1
# Dev direct-run recommended: TRUST_PROXY=0
# Behind reverse proxy in production: TRUST_PROXY=1
TRUST_PROXY=0
APP_BASE_URL=http://127.0.0.1:3000
HEALTH_EXPOSE_COUNTS=false
# Set true only when you need script/curl write-access without Origin/Referer.
ADMIN_ALLOW_HEADERLESS_MUTATION=false
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_DIR=./logs
ACCESS_LOG_ENABLED=true
ACCESS_LOG_SKIP_HEALTH=true
ACCESS_LOG_SLOW_MS=800
SESSION_COOKIE_NAME=kws_sid
SESSION_TTL_HOURS=168
BCRYPT_ROUNDS=12
ADMIN_USERNAME=admin
# Keep empty by default to avoid accidental weak-password bootstrap.
ADMIN_PASSWORD=
DB_PATH=./data/workstation.db
RATE_LIMIT_SUBMIT_WINDOW_MS=600000
RATE_LIMIT_SUBMIT_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=120
DISPLAY_TIMEZONE=Asia/Shanghai
DISPLAY_LOCALE=zh-CN
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# SMTP email notification (external provider)
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notify@example.com
# Multiple recipients separated by comma
SMTP_TO=admin1@example.com,admin2@example.com
SMTP_SUBJECT_PREFIX=[KyanetWorkStation]

# Webhook notification (wecom/feishu/dingtalk/slack/generic)
WEBHOOK_ENABLED=false
WEBHOOK_PROVIDER=generic
# Multiple webhook URLs separated by comma
WEBHOOK_URLS=
# Optional secret (generic signature / DingTalk signature)
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_TITLE_PREFIX=[KyanetWorkStation]


